{
  "name": "landscape-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next-auth": "^4.24.15",
    "@prisma/client": "^6.19.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/react": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "sharp": "^0.35.5",
    "bcryptjs": "^3.0.3",
    "lucide-react": "1.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "prisma": "^6.19.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "vitest": "^5.1.0",
    "@testing-library/react": "^16.0.0",
    "jsdom": "^27.0.0",
    "@playwright/test": "^1.65.0"
  }
}
